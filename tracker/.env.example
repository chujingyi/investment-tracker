# Flask session signing key (CHANGE IN PRODUCTION!)
SECRET_KEY=change-me-to-a-random-string

# API key for external tools (Claude integration)
# If not set, external write APIs are disabled
API_KEY=

# Required on a public deployment
APP_USERNAME=
APP_PASSWORD=

# Turso remote SQLite
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Longbridge OpenAPI credentials
LONGBRIDGE_APP_KEY=
LONGBRIDGE_APP_SECRET=
LONGBRIDGE_ACCESS_TOKEN=
LONGBRIDGE_REGION=cn

# Flask debug mode (0 = off, 1 = on)
FLASK_DEBUG=0

# Server port
PORT=5050

# Agent (no API key = disabled). Credentials stay on the server.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_FAST_MODEL=
LLM_STRONG_MODEL=
LLM_REVIEW_MODEL=
LLM_TIMEOUT_SECONDS=45
LLM_MAX_OUTPUT_TOKENS=1024
AGENT_MAX_ITERATIONS=8
AGENT_RUN_TIMEOUT_SECONDS=90
AGENT_DAILY_TOKEN_BUDGET=200000
AGENT_MORNING_ENABLED=1
AGENT_VERSION=investment-v1
# Estimated CNY per million tokens; set using your actual provider billing.
LLM_INPUT_PRICE_PER_M=1
LLM_OUTPUT_PRICE_PER_M=2
